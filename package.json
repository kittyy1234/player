{
  "name": "kitty123",
  "productName": "kitty123",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.kitty123.app",
    "productName": "kitty123",
    "mac": {
      "category": "public.app-category.music",
      "target": "dir",
      "icon": "build/icon.png"
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
